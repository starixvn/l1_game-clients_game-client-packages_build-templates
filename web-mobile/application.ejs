let cc;
let worker = null;
let timeOutStopWorker = null;
let isTimeoutWorker = false;
const durationTimeout = 3 * 60 * 1000;

function setLoadingDisplay() {
  var splash = document.getElementById("splash");
  var gameCanvas = document.getElementById("GameCanvas");
  gameCanvas.style.display = "none";
  splash.style.display = "block";

  cc.director.once(cc.Director.EVENT_AFTER_RENDER, function () {
      gameCanvas.style.display = "block";
      splash.style.display = "none";
      document.body.style.background = "#000";
  });
}

const reloadIfTimeoutWorker = (isTimeoutWorker) => {
    if (isTimeoutWorker) {
        window.location.reload();
    }
};

const initWorker = () => {
    const canvas = document.getElementById("GameCanvas");

    const stopWorker = () => {
        if (worker) {
            console.log("stopWorker client------")
            worker.terminate();
            worker = null;
            clearTimeout(timeOutStopWorker);
            timeOutStopWorker = null;
        }
    };

    const startWorker = () => {
        console.log("startWorker client++++++")
        isTimeoutWorker = false;
        worker = new Worker("worker.js");
        timeOutStopWorker = setTimeout(() => {
            stopWorker();
            isTimeoutWorker = true;
        }, durationTimeout);
        worker.onmessage = function (event) {
            try {
                if (cc?.game) {
                    cc.game?.step();
                } else {
                    stopWorker();
                }
            } catch (error) {
                stopWorker();
            }
        };
    };

    // Start worker when game is hidden
    cc.game.on(cc.Game.EVENT_HIDE, () => {
       !isTimeoutWorker && startWorker();
    });

    // Stop worker when game is enable
    cc.game.on(cc.Game.EVENT_SHOW, () => {
        reloadIfTimeoutWorker(isTimeoutWorker);
        stopWorker();
    });

    // Stop worker when the canvas gets focus
    canvas.onfocus = () => {
        stopWorker();
    };

    // Stop the worker when the page is unloaded
    window.addEventListener("beforeunload", () => {
        stopWorker();
    });

    // Create a new IntersectionObserver instance
    const observer = new IntersectionObserver(
        (entries) => {
            entries.forEach((entry) => {
                if (entry.target === canvas) {
                    if (entry.isIntersecting) {
                        // The canvas is visible in the viewport
                        reloadIfTimeoutWorker(isTimeoutWorker);
                        stopWorker();
                    } else {
                        // The canvas is fully hidden
                        startWorker();
                    }
                }
            });
        },
        { threshold: 0 }
    );

    // Start observing the canvas element
    observer.observe(canvas);
};


export class Application {
    constructor () {
        this.settingsPath = '<%= settingsJsonPath %>'; // settings.json file path, usually passed in by the editor when building, you can also specify your own path
        this.showFPS = <%= showFPS %>; // Whether or not to open the profiler, usually passed in when the editor is built, but you can also specify the value you want
    }

    init (engine) {
        cc = engine;
        cc.game.onPostBaseInitDelegate.add(this.onPostInitBase.bind(this)); // Listening for engine start process events onPostBaseInitDelegate
        cc.game.onPostSubsystemInitDelegate.add(this.onPostSystemInit.bind(this)); // Listening for engine start process events onPostSubsystemInitDelegate
    
    }

    onPostInitBase () {
        // cc.settings.overrideSettings('assets', 'server', '');
        // Implement some custom logic
        if (cc.sys.isBrowser) {
            setLoadingDisplay();
        }
    }

    onPostSystemInit () {
        // Implement some custom logic
    }

    start () {
        return cc.game.init({ // Run the engine with the required parameters
            debugMode: <%= debugMode %> ? cc.DebugMode.INFO : cc.DebugMode.ERROR,
            settingsPath: this.settingsPath, // Pass in the settings.json path
            overrideSettings: { // Override part of the data in the configuration file, this field will be described in detail below
                // assets: {
                //      preloadBundles: [{ bundle: 'main', version: 'xxx' }],
                // }
                profiling: {
                    showFPS: this.showFPS,
                }
            }
        }).then(() => {
            cc.game.run();
            initWorker();
        });
    }
}